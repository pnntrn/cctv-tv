# Optional local build variables; this is documentation, not an automatically loaded dotenv file.
# Debug builds do not need release signing. CI supplies retained signing through repository secrets.
# Never commit a keystore, password, token, local.properties, or a populated environment file.
JAVA_HOME=/path/to/jdk-17
ANDROID_HOME=/path/to/android-sdk
# Optional private Gradle cache location:
# GRADLE_USER_HOME=/path/to/gradle-cache
# Only for an authorized retained-key release build:
# CCTV_KEYSTORE_PATH=/absolute/private/path/to/retained-release.p12
# CCTV_STORE_PASSWORD=replace-locally-never-commit
# CCTV_KEY_ALIAS=replace-locally
# CCTV_SIGNING_BUNDLE is a CI secret; do not place it in this file.
